  "main": "index.js",
  "scripts": {
    "build:css": "postcss themes/polish-davmar/assets/css/main.css -o static/css/main.css",
    "watch:css": "postcss themes/polish-davmar/assets/css/main.css -o static/css/main.css --watch",
